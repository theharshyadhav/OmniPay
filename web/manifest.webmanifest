{
  "name": "OmniPay",
  "short_name": "OmniPay",
  "description": "Pay anyone with whatever you hold: money, crypto or shares. No fees, no spread.",
  "id": "/",
  "start_url": "/#/home",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#EDF0F5",
  "theme_color": "#132034",
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "shortcuts": [
    { "name": "Scan and pay", "url": "/#/scan", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "My QR code", "url": "/#/profile", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Pay", "url": "/#/pay", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
