# --- core ---
OMNIPAY_DB=/data/omnipay.db
OMNIPAY_DEMO=1                 # seeded demo users + reset button + simulated PayPal approval. NEVER in production.
ADMIN_TOKEN=
# --- PayPal (leave empty to use the built-in simulated PayPal) ---
PAYPAL_ENV=sandbox             # sandbox | live. live is refused unless OMNIPAY_ALLOW_LIVE=1 (see LAUNCH_READINESS.md)
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_CURRENCIES=USD,EUR,GBP
# OMNIPAY_ALLOW_LIVE=1         # do NOT set until every gate in LAUNCH_READINESS.md is closed
# --- Groq (leave empty to run on the deterministic fallback) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_ADVISOR_MODEL=openai/gpt-oss-120b
GROQ_STRUCT_MODEL=openai/gpt-oss-20b
